{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 10000000,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.idea",
      "!**/coverage",
      "!**/pnpm-lock.yaml",
      "!**/.changeset"
    ]
  },
  "formatter": {
    "useEditorconfig": true,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "lineWidth": 120,
      "indentStyle": "space"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off",
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/packages/**"],
                "message": "using imports from packages/* is not allowed"
              }
            ]
          }
        }
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "fix": "safe"
        },
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "error",
        "noUndeclaredDependencies": "off",
        "noInvalidUseBeforeDeclaration": "error"
      },
      "suspicious": {
        "noConsole": "error"
      },
      "complexity": {
        "noBannedTypes": "error"
      },
      "performance": {
        "noDelete": {
          "fix": "none",
          "level": "error"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts", "**/__tests__/**", "**/vitest.*.ts", "**/scripts/**", "**/tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noNonNullAssertedOptionalChain": "off"
          },
          "complexity": {
            "useArrowFunction": "off"
          }
        }
      }
    }
  ]
}
