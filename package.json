{
  "name": "2060-ts-template",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Single-app TypeScript project template for 2060-io",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check-format": "biome check --unsafe",
    "fix-format": "biome check --write --unsafe",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "validate": "pnpm check-types && pnpm check-format"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.5"
}
