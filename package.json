{
  "name": "2060-ts-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-app TypeScript project template for 2060-io",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check-format": "biome ci .",
    "fix-format": "biome check --write",
    "fix-format:unsafe": "biome check --write --unsafe",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm check-types && pnpm check-format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/node": "^25.2.3",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "vitest": "^1.4.0"
  },
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
